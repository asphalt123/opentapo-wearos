<?xml version="1.0" encoding="utf-8"?>
<!-- Google Assistant App Actions : « Ok Google, allume la prise du salon avec OpenTapo ». -->
<actions>
    <action intentName="actions.intent.OPEN_APP_FEATURE">
        <fulfillment urlTemplate="opentapo://voice{?feature}">
            <parameter-mapping
                intentParameter="feature"
                urlParameter="feature" />
        </fulfillment>
    </action>
</actions>
