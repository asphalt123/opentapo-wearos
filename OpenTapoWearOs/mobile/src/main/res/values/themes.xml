<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenTapoMobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/op_background</item>
        <item name="colorPrimary">@color/op_primary</item>
        <item name="colorOnPrimary">@color/op_on_primary</item>
        <item name="colorPrimaryContainer">@color/op_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/op_on_primary_container</item>
        <item name="colorSecondary">@color/op_accent</item>
        <item name="colorOnSecondary">@color/op_background</item>
        <item name="colorSurface">@color/op_surface</item>
        <item name="colorOnSurface">@color/op_text_primary</item>
        <item name="colorSurfaceVariant">@color/op_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/op_text_secondary</item>
        <item name="colorError">@color/op_error</item>
        <item name="android:statusBarColor">@color/op_background</item>
        <item name="android:navigationBarColor">@color/op_background</item>
        <item name="android:windowAnimationStyle">@style/OpenTapoWindowAnim</item>
        <item name="materialButtonStyle">@style/OpenTapoButton</item>
        <item name="textInputStyle">@style/OpenTapoInput</item>
        <item name="snackbarStyle">@style/OpenTapoSnackbar</item>
    </style>

    <style name="OpenTapoWindowAnim">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <style name="OpenTapoButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/op_primary</item>
    </style>

    <style name="OpenTapoInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/op_outline</item>
        <item name="hintTextColor">@color/op_text_secondary</item>
    </style>

    <style name="OpenTapoSnackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/op_surface_variant</item>
    </style>

    <style name="OpenTapoCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/op_surface</item>
        <item name="cardCornerRadius">20dp</item>
    </style>
</resources>
