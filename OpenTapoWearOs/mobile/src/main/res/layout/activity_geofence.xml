<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_geofence"
            android:textColor="@color/op_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/geofence_hint"
            android:textColor="@color/op_text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/geofence_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/geofence_label_hint"
            android:inputType="text"
            android:textColor="@color/op_text_primary"
            android:textColorHint="@color/op_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/geofence_lat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/geofence_lat_hint"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="@color/op_text_primary"
                android:textColorHint="@color/op_text_secondary" />

            <EditText
                android:id="@+id/geofence_lng"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="@string/geofence_lng_hint"
                android:inputType="numberSigned|numberDecimal"
                android:textColor="@color/op_text_primary"
                android:textColorHint="@color/op_text_secondary" />
        </LinearLayout>

        <Button
            android:id="@+id/geofence_here"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/geofence_here" />

        <TextView
            android:id="@+id/geofence_radius_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/op_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/geofence_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/geofence_devices_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/op_text_primary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/geofence_pick_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/geofence_pick_devices" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/geofence_enter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/geofence_exit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/geofence_on_enter"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/geofence_on_exit"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/geofence_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/geofence_save" />

        <TextView
            android:id="@+id/geofence_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/geofence_none"
            android:textColor="@color/op_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/geofence_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
