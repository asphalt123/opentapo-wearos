<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/control_alias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/op_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/control_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/op_text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/control_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:indeterminateTint="@color/op_accent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/control_power"
                android:textColor="@color/op_text_primary"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/control_power"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/control_brightness_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/control_brightness_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/op_text_primary"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/control_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:min="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/control_color_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/control_color_title"
                android:textColor="@color/op_text_primary"
                android:textSize="16sp" />

            <com.hn.otapo.control.ColorWheelView
                android:id="@+id/control_wheel"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/control_color_hint"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/control_temp_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/control_temp_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/op_text_primary"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/control_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />
        </LinearLayout>

        <Button
            android:id="@+id/control_energy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:text="@string/menu_energy"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
