<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/op_background"
    android:scrollbarThumbVertical="@color/op_outline"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="⚡"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/login_activity_title"
            android:textColor="@color/op_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/login_activity_loading_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:indeterminateTint="@color/op_accent"
                android:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lines="2"
                android:maxLines="4"
                android:layout_marginTop="8dp"
                android:text="@string/login_activity_submit_loading"
                android:textColor="@color/op_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/activity_login_login_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/activity_login_username_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/login_activity_email"
                android:textColor="@color/op_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/activity_login_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:ems="12"
                android:gravity="center"
                android:hint="@string/login_activity_email_input"
                android:textColor="@color/op_text_primary"
                android:textColorHint="@color/op_text_secondary"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:minHeight="52dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/activity_login_password_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:text="@string/login_activity_password"
                android:textColor="@color/op_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <EditText
                android:id="@+id/activity_login_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:ems="12"
                android:gravity="center"
                android:hint="@string/login_activity_password_input"
                android:textColor="@color/op_text_primary"
                android:textColorHint="@color/op_text_secondary"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="52dp"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/activity_login_save_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="48dp"
                android:padding="4dp"
                android:text="@string/login_activity_save_password"
                android:textColor="@color/op_text_secondary"
                android:textSize="12sp"
                android:thumbTint="@color/op_accent" />

            <TextView
                android:id="@+id/activity_login_error_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lines="2"
                android:maxLines="4"
                android:text=""
                android:textColor="@color/op_error"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
